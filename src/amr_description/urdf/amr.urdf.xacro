<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr">
  <!-- Kich thuoc banh xe lay tu firmware STM32. -->
  <xacro:property name="wheel_radius" value="0.0325"/>
  <xacro:property name="wheel_base" value="0.215"/>
  <xacro:property name="wheel_width" value="0.026"/>

  <!-- Kich thuoc khung va vi tri LiDAR can do lai tren robot that. -->
  <xacro:property name="body_length" value="0.335"/>
  <xacro:property name="body_width" value="0.265"/>
  <xacro:property name="body_height" value="0.080"/>

  <material name="gray"><color rgba="0.35 0.35 0.35 1"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_height / 2}"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 ${wheel_base / 2} 0" rpy="1.5708 0 0"/>
  </joint>
  <link name="left_wheel">
    <visual>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 ${-wheel_base / 2} 0" rpy="1.5708 0 0"/>
  </joint>
  <link name="right_wheel">
    <visual>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="-0.10 0 0.175" rpy="0 0 3.14159"/>
  </joint>
  <link name="laser_frame"/>
</robot>
