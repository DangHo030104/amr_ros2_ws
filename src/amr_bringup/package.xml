<?xml version="1.0"?>
<package format="3">
  <name>amr_bringup</name>
  <version>0.1.0</version>
  <description>Launch the AMR hardware, transforms and odometry.</description>
  <maintainer email="black@todo.todo">black</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>amr_description</exec_depend>
  <exec_depend>amr_lidar</exec_depend>
  <exec_depend>amr_odometry</exec_depend>
  <exec_depend>amr_serial_bridge</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
